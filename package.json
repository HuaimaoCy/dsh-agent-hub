{
  "name": "dsh-agent-hub",
  "version": "0.1.2",
  "private": true,
  "description": "Agent Hub for DSH: run several agents on different models at the same time and watch them exchange progress on one board.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "src",
    "tests",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "CONTRACT.md",
    "restart-web.ps1"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "test": "node --no-warnings tests/smoke.mjs && node --no-warnings tests/integration.mjs"
  }
}
